# Copy to .env for local development. Vite only exposes vars prefixed VITE_.

# Base URL of the backend API (see server/README.md).
VITE_API_URL=http://localhost:4000

# OAuth 2.0 Client ID from Google Cloud Console, same one configured as
# GOOGLE_CLIENT_ID on the backend. Leave unset to keep the "Continue with
# Google" button disabled with an explanatory message instead of failing
# at click time.
VITE_GOOGLE_CLIENT_ID=
