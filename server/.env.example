# Copy to .env and fill in for local development.

PORT=4000

# Postgres connection string. For local dev against the docker-compose
# stack this matches docker-compose.yml's `db` service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/senior_concierge

# Signs and verifies session access tokens. Generate a real random value
# for any non-local environment, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# OAuth 2.0 Client ID from Google Cloud Console (Credentials > OAuth
# client ID > Web application). The frontend uses Google Identity
# Services to get an ID token; this backend verifies it against this
# client ID. Leave unset to disable the Google sign-in endpoint.
GOOGLE_CLIENT_ID=

# 'console' (default) logs OTP codes and alerts to stdout and marks them
# "sent" immediately -- no real SMS/WhatsApp is sent. Set to 'twilio' to
# send for real once the TWILIO_* vars below are filled in.
NOTIFICATIONS_PROVIDER=console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS_NUMBER=
TWILIO_FROM_WHATSAPP_NUMBER=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
